{
  "name": "electron-client",
  "version": "0.1.0",
  "description": "RapidMX desktop client. An Electron shell around the same @rapidmx/web-client React UI.",
  "type": "module",
  "private": true,
  "repository": "https://github.com/rapidmx/electron-client",
  "author": "Jean-Philippe Steinmetz <rapidrests@gmail.com>",
  "license": "MPL-2.0",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "rimraf dist/main && tsc -p tsconfig.main.json",
    "build:renderer": "rimraf dist/renderer && vite build",
    "build": "yarn build:main && yarn build:renderer",
    "dev": "concurrently -k -n renderer,main,electron \"yarn dev:renderer\" \"yarn dev:main\" \"yarn dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:5173 dist/main/index.js && cross-env ELECTRON_RENDERER_URL=http://localhost:5173 electron .",
    "start": "electron .",
    "lint": "eslint ./src ./test",
    "test": "vitest run --coverage",
    "test:watch": "vitest --watch --coverage",
    "release": "npx @rapidrest/cli release"
  },
  "prettier": {
    "printWidth": 120,
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "trailingComma": "es5"
  },
  "dependencies": {
    "@rapidmx/react-shared": "link:../react-shared",
    "@rapidmx/web-client": "link:../web-client",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^34.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^64.3.8",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wait-on": "^8.0.2"
  },
  "packageManager": "yarn@4.5.3",
  "engines": {
    "node": ">=24.0.0"
  }
}
